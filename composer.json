{
    "name": "bvp/amagasaki-scraper",
    "description": "The BVP Amagasaki Scraper package for Boatrace.",
    "keywords": [
        "boatrace",
        "library",
        "scraper"
    ],
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "shimomo",
            "email": "developer@shimomo.net"
        }
    ],
    "support": {
        "issues": "https://github.com/shimomo/bvp-amagasaki-scraper/issues",
        "source": "https://github.com/shimomo/bvp-amagasaki-scraper"
    },
    "require": {
        "php": "^8.2",
        "bvp/scraper-core": "^5.x-dev",
        "nesbot/carbon": "^2.63 || ^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1 || ^11.1 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "BVP\\AmagasakiScraper\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BVP\\AmagasakiScraper\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
